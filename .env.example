# ── Base de datos (Supabase) ──────────────────────────────────────────────────
# Pooler de transacciones — para Prisma Client en runtime (puerto 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Conexión directa — para migraciones (puerto 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ── OpenRouter (proveedor de IA) ─────────────────────────────────────────────
# Crea cuenta en openrouter.ai — modelos gratuitos disponibles
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ── Acceso sin límite (owner) ─────────────────────────────────────────────────
# Genera un string aleatorio largo: openssl rand -hex 32
# Envíalo como header: x-owner-key: <valor>
OWNER_BYPASS_KEY=change-this-to-a-long-random-secret

# ── Supabase JS client (futuro, opcional) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
