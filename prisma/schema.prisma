generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────── USUARIOS ─────────────

model User {
  id          String  @id @default(uuid())
  email       String  @unique
  displayName String?

  plan              Plan     @default(FREE)
  searchesThisMonth Int      @default(0)
  searchesResetAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  searchHistory     UserSearchHistory[]
  followUpQuestions FollowUpQuestion[]
  subscription      Subscription?
  searchEvents      SearchEvent[]
  bookmarks         Bookmark[]

  @@map("users")
}

enum Plan {
  FREE
  PRO
}

// ───────────── ANÁLISIS (CACHÉ GLOBAL) ─────────────

model SearchRecord {
  id       String   @id @default(uuid())
  word     String
  context  String?
  language Language @default(EN)

  analysisJson Json

  shareId String @unique @default(cuid())

  createdAt DateTime @default(now())

  userHistory       UserSearchHistory[]
  followUpQuestions FollowUpQuestion[]
  searchEvents      SearchEvent[]
  bookmarks         Bookmark[]

  @@unique([word, language])
  @@index([word])
  @@index([shareId])
  @@map("search_records")
}

enum Language {
  EN
  ES
}

// ───────────── HISTORIAL POR USUARIO ─────────────

model UserSearchHistory {
  id             String   @id @default(uuid())
  userId         String
  searchRecordId String
  viewedAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchRecord SearchRecord @relation(fields: [searchRecordId], references: [id], onDelete: Cascade)

  @@unique([userId, searchRecordId])
  @@index([userId, viewedAt])
  @@map("user_search_history")
}

// ───────────── PREGUNTAS DE SEGUIMIENTO ─────────────

model FollowUpQuestion {
  id             String  @id @default(uuid())
  searchRecordId String
  userId         String?

  question String
  answer   String

  createdAt DateTime @default(now())

  searchRecord SearchRecord @relation(fields: [searchRecordId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([searchRecordId])
  @@map("follow_up_questions")
}

// ───────────── EVENTOS DE BÚSQUEDA ─────────────

model SearchEvent {
  id       String   @id @default(uuid())
  word     String
  context  String?
  language Language

  userId         String?
  searchRecordId String
  cacheHit       Boolean @default(false)
  ipHash         String?

  createdAt DateTime @default(now())

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  searchRecord SearchRecord @relation(fields: [searchRecordId], references: [id], onDelete: Cascade)

  @@index([word])
  @@index([createdAt])
  @@index([userId])
  @@index([ipHash, cacheHit, createdAt])
  @@map("search_events")
}

// ───────────── FAVORITOS ─────────────

model Bookmark {
  id             String @id @default(uuid())
  userId         String
  searchRecordId String

  folder String?
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  searchRecord SearchRecord @relation(fields: [searchRecordId], references: [id], onDelete: Cascade)

  @@unique([userId, searchRecordId])
  @@index([userId, folder])
  @@map("bookmarks")
}

// ───────────── SUSCRIPCIONES ─────────────

model Subscription {
  id               String             @id @default(uuid())
  userId           String             @unique
  lemonSqueezyId   String             @unique
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
}

// ───────────── WAITLIST ─────────────

model WaitlistEmail {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist_emails")
}

// ───────────── RATE LIMITING (durable, cross-instance) ─────────────
// One row per metered request. Counted per (scope, ipHash) within a time
// window to enforce limits that survive serverless cold starts.

model RateLimitEvent {
  id        String   @id @default(uuid())
  scope     String
  ipHash    String
  createdAt DateTime @default(now())

  @@index([scope, ipHash, createdAt])
  @@map("rate_limit_events")
}
